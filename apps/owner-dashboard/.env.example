# ── Owner Dashboard Environment Variables ──
# Deployed Render Backend API URL (must include /api/v1 or root URL)
# Example: https://cafe-api.onrender.com/api/v1
VITE_API_URL=https://your-api-name.onrender.com/api/v1

# Real-time WebSocket / Socket.io Server URL (Optional: defaults to root of VITE_API_URL)
# Example: https://cafe-api.onrender.com
VITE_SOCKET_URL=https://your-api-name.onrender.com
