# ── Server Configuration ──
PORT=5000
NODE_ENV=production

# ── Database (MongoDB Atlas) ──
# Get this connection string from MongoDB Atlas: Clusters -> Connect -> Drivers -> Node.js
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cafe_dream?retryWrites=true&w=majority"

# ── Security & Authentication ──
# Generate strong 64-character random strings in production
JWT_SECRET="generate-a-strong-random-secret-key-for-jwt"
JWT_REFRESH_SECRET="generate-a-strong-random-refresh-secret-key"
JWT_EXPIRES_IN="30d"
JWT_REFRESH_EXPIRES_IN="365d"

# ── Allowed Frontends (CORS) ──
# URLs where your frontends are hosted on Vercel
CUSTOMER_WEB_URL="https://your-customer-app.vercel.app"
OWNER_DASHBOARD_URL="https://your-owner-dashboard.vercel.app"
# Optional: DELIVERY_APP_URL="https://your-delivery-app.vercel.app"

# ── Payments (Stripe - Optional / Sandbox) ──
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ── WhatsApp Gateway (Optional) ──
WHATSAPP_GATEWAY_URL="http://localhost:5001"
