{
  "name": "cafeos",
  "version": "1.0.0",
  "private": true,
  "description": "CafeOS — Multi-Business Restaurant Management Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:customer": "npm run dev -w apps/customer-web",
    "dev:owner": "npm run dev -w apps/owner-dashboard",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:studio": "npm run db:studio -w apps/api"
  },
  "devDependencies": {
    "autocannon": "^8.0.0"
  }
}
