# ── API ──────────────────────────────────────
DATABASE_URL="file:./dev.db"
# For PostgreSQL (production): DATABASE_URL="postgresql://user:password@host:5432/cafeos"

JWT_SECRET="your-jwt-secret-change-me"
JWT_REFRESH_SECRET="your-refresh-secret-change-me"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=5000

# ── Cloudinary (image uploads) ───────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Firebase (push notifications) ────────────
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# ── WhatsApp Gateway ─────────────────────────
WHATSAPP_ENABLED=false

# ── Frontend URLs ────────────────────────────
CUSTOMER_WEB_URL="http://localhost:5173"
OWNER_DASHBOARD_URL="http://localhost:5174"
DELIVERY_APP_URL="http://localhost:5175"
